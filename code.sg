/*****************************************************************************
 *  Lotes · Sistema de venta de terrenos a plazos (México)
 *  Archivo 1/2 : Code.gs   (backend en Google Apps Script)
 *  Archivo 2/2 : Index.html (interfaz)
 *
 *  INSTALACIÓN RÁPIDA
 *   1. Crea una Hoja de cálculo de Google → Extensiones → Apps Script.
 *   2. Pega este archivo como Code.gs y crea un archivo HTML llamado "Index".
 *   3. Configuración del proyecto → zona horaria: (GMT-08:00) America/Tijuana
 *      (o la que uses; es la que se usa para fechas y vencimientos).
 *   4. Ejecuta  setupDatabase()  (o menú "🏡 Inmobiliaria" al recargar la hoja).
 *      Crea hojas, columnas, formatos, listas desplegables y el usuario
 *      administrador. La contraseña temporal sale en la alerta y en el registro.
 *   5. Ejecuta  instalarTriggers()  para activar los avisos diarios de abonos.
 *   6. Implementar → Nueva implementación → Aplicación web
 *        Ejecutar como: Yo   ·   Quién tiene acceso: Cualquier persona
 *      (el acceso real lo controla el login propio de la app).
 *
 *  SEGURIDAD
 *   · Contraseñas: SHA-256 con sal por usuario + pimienta secreta + 200 rondas.
 *   · Sesión: token aleatorio en CacheService (máx. 6 h, se renueva al usar).
 *   · Bloqueo 15 min tras 5 intentos fallidos por correo.
 *   · Cada acción valida token + rol + usuario activo EN EL SERVIDOR.
 *   · Las funciones administrativas solo las puede ejecutar el propietario.
 *   · Los textos se limpian contra inyección de fórmulas en la hoja.
 *   · NO compartas la hoja de cálculo con los vendedores (contiene los hashes).
 *****************************************************************************/

/* ============================ CONFIGURACIÓN ============================== */
const APP = {
  SESION_SEG: 21600,   // 6 h (máximo de CacheService)
  CACHE_SEG: 21600,
  CHUNK: 30000,        // caracteres por trozo de caché (límite 100 KB por clave)
  HASH_ROUNDS: 200,
  MAX_INTENTOS: 5,
  BLOQUEO_SEG: 900,
  VENTANA_DIAS: 60     // ventana de cobranza hacia adelante (caché ligero)
};

const AMBOS = ['admin', 'vendedor'];
const ADMIN = ['admin'];

/* Esquema de la "base de datos": una hoja por tabla */
const TABLAS = {
  USU: { hoja: 'Usuarios',          color: '#6d28d9', cols: ['ID','Nombre','Email','Rol','Hash','Salt','Activo','CambiarPass','UltimoAcceso','Creado'] },
  FRA: { hoja: 'Fraccionamientos',  color: '#0f766e', cols: ['ID','Nombre','Ubicacion','Municipio','Estado','Descripcion','PrecioM2','Estatus','Creado'] },
  LOT: { hoja: 'Lotes',             color: '#0369a1', cols: ['ID','FraccID','Manzana','Lote','Frente','Fondo','Area','PrecioM2','Precio','Estatus','VentaID','Notas'] },
  CLI: { hoja: 'Clientes',          color: '#b45309', cols: ['ID','Nombre','Telefono','Email','CURP','RFC','INE','Domicilio','EstadoCivil','Ocupacion','Beneficiario','VendedorID','Notas','Creado'] },
  VEN: { hoja: 'Ventas',            color: '#15803d', cols: ['ID','Fecha','ClienteID','LoteID','VendedorID','Descuento','PrecioFinal','Enganche','Plazo','TasaAnual','Mensualidad','DiaPago','PrimerPago','Estatus','Pagado','Saldo','Notas'] },
  ABO: { hoja: 'Abonos',            color: '#be123c', cols: ['VentaID','Num','Vence','Monto','Pagado','FechaPago','Metodo','Referencia','Estatus','UltAviso','Usuario'] },
  CFG: { hoja: 'Config',            color: '#475569', cols: ['Clave','Valor','Descripcion'] },
  LOG: { hoja: 'Bitacora',          color: '#64748b', cols: ['Cuando','Usuario','Accion','Detalle'] }
};

const MONEDA    = new Set(['PrecioM2','Precio','Descuento','PrecioFinal','Enganche','Mensualidad','Pagado','Saldo','Monto']);
const FECHA     = new Set(['Fecha','PrimerPago','Vence','FechaPago','UltAviso']);
const FECHAHORA = new Set(['Creado','UltimoAcceso','Cuando']);
const TEXTO     = new Set(['ID','VentaID','ClienteID','LoteID','FraccID','VendedorID','Manzana','Lote','Telefono','CURP','RFC','INE','Referencia','Clave']);
const DEC       = new Set(['Frente','Fondo','Area']);
const ENT       = new Set(['Plazo','DiaPago','Num','TasaAnual']);

const LISTAS = {
  'USU.Rol': ['admin','vendedor'], 'USU.Activo': ['SI','NO'], 'USU.CambiarPass': ['SI','NO'],
  'FRA.Estatus': ['Activo','Inactivo'],
  'LOT.Estatus': ['Disponible','Apartado','Vendido'],
  'VEN.Estatus': ['Contrato','Activa','Liquidada','Cancelada'],
  'ABO.Estatus': ['Pendiente','Parcial','Pagado']
};

/* Parámetros editables desde la pantalla Configuración */
const CFG_DEF = [
  ['EMPRESA_NOMBRE','Inmobiliaria Los Pinos','Nombre comercial'],
  ['EMPRESA_RAZON','Inmobiliaria Ranchito S.A. de C.V.','Razón social (para contratos)'],
  ['EMPRESA_RFC','XXX000000XXX','RFC de la empresa'],
  ['EMPRESA_DIRECCION','Domicilio fiscal de la empresa','Domicilio'],
  ['EMPRESA_TEL','','Teléfono de contacto'],
  ['EMPRESA_EMAIL','','Correo de contacto (se usa como Reply-To)'],
  ['REPRESENTANTE','Representante legal','Nombre de quien firma por la empresa'],
  ['CIUDAD','Tijuana, Baja California','Ciudad/jurisdicción para contratos'],
  ['DIAS_AVISO','3','Días de anticipación para avisar un abono'],
  ['AVISO_CLIENTE','SI','Enviar correo al cliente (SI/NO)'],
  ['HORA_NOTIF','8','Hora del envío diario (0-23)'],
  ['MIN_ENGANCHE_PCT','10','% mínimo de enganche para vendedores'],
  ['MAX_DESCUENTO_PCT','5','% máximo de descuento para vendedores'],
  ['MAX_PLAZO','120','Plazo máximo en meses'],
  ['TASA_MORATORIA','3','% mensual de interés moratorio (se imprime en el contrato)'],
  ['VENDEDOR_VE_TODO','NO','SI = el vendedor ve clientes/ventas de todos; NO = solo los suyos'],
  ['BITACORA_MAX','3000','Máximo de renglones que conserva la bitácora'],
  ['CONTRATO_PLANTILLA', '', 'Plantilla del contrato (usa {{MARCADORES}})']
];

